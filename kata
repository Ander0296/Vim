#!/usr/bin/env bash
# Corre una kata de edición con un solo comando, desde la raíz del repo:
#   ./kata k02       una kata
#   ./kata k01-r1    su repaso
# Copia el inicio sobre trabajo, abre nvim grabando cada tecla en teclas.log
# y, al salir, compara contra el objetivo. Cada corrida es un intento nuevo
# desde cero: pisa el trabajo y el teclas.log del intento anterior.

set -euo pipefail
shopt -s nullglob

raiz="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
id="${1:-}"

if [[ ! "$id" =~ ^k[0-9]+(-r[0-9]+)?$ ]]; then
  echo "Uso: ./kata kNN      (una kata, ej: ./kata k02)"
  echo "     ./kata kNN-rX   (un repaso, ej: ./kata k01-r1)"
  exit 1
fi

if [[ "$id" == *-r* ]]; then
  carpetas=("$raiz/ejercicios/repasos/${id%-r*}-"*"-${id##*-}/")
else
  carpetas=("$raiz/ejercicios/$id-"*/)
fi
if (( ${#carpetas[@]} != 1 )); then
  echo "No encontré una sola carpeta para $id en ejercicios/ (encontré ${#carpetas[@]})."
  exit 1
fi
cd "${carpetas[0]}"

inicios=(inicio.*)
if (( ${#inicios[@]} != 1 )) || [[ ! -f "objetivo.${inicios[0]#inicio.}" ]]; then
  echo "A la carpeta $(basename "$PWD") le falta su inicio.* o su objetivo.*."
  exit 1
fi
ext="${inicios[0]#inicio.}"

cp "inicio.$ext" "trabajo.$ext"
# env -u: siempre la config real (nvim), aunque NVIM_APPNAME apunte a otra.
# -c: el cursor arranca en la línea 1, columna 0 (LazyVim lo devuelve
# adonde quedó la última vez que se cerró ese mismo archivo).
env -u NVIM_APPNAME nvim -W teclas.log -c 'normal! gg0' "trabajo.$ext" || true

# La última línea es siempre un comando exacto, listo para copiar y pegar.
echo
if diff --color=auto -u "trabajo.$ext" "objetivo.$ext"; then
  echo "✅ Salió: trabajo.$ext quedó idéntico al objetivo."
  echo "   Entregá en Claude con esto, y agregá qué comandos usaste y por qué:"
  echo
  echo "/entrega $id"
else
  echo
  echo "❌ Todavía no. Arriba: las líneas con - son tu archivo, las con + el objetivo."
  echo "   Para otro intento desde cero, copiá y pegá esto:"
  echo
  echo "cd ${raiz/#$HOME/\~} && ./kata $id"
fi
